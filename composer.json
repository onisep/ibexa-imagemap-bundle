{
    "name": "onisep/ibexa-imagemap-bundle",
    "description": "Image map field type for Ibexa 5.0+",
    "type": "symfony-bundle",
    "keywords": ["ibexa", "image map"],
    "license": "MIT",
    "authors": [
        {
            "name": "Jérémy J.",
            "email": "jeremy@code-rhapsodie.fr",
            "role": "Developer"
        },
        {
            "name": "Code Rhapsodie",
            "homepage": "https://www.code-rhapsodie.fr/"
        },
        {
            "name": "Onisep",
            "homepage": "https://www.onisep.fr/"
        },
        {
            "name": "Other contributors",
            "homepage": "https://github.com/onisep/imagemap-bundle/graphs/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "Onisep\\IbexaImageMapBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Onisep\\IbexaImageMapBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "guzzlehttp/promises": "^2.3",
        "ibexa/admin-ui": "^5.0",
        "ibexa/core": "^5.0",
        "nyholm/psr7": "^1.8"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "ibexa/rector": "^5.0"
    }
}
